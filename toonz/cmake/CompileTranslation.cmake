# Some generators may revisit an otherwise current custom rule. Avoid invoking
# lrelease unless its input/tool changed or the runtime output is missing/altered.
file(SHA256 "${SOURCE}" source_hash)
file(SHA256 "${LRELEASE}" tool_hash)
set(signature "${source_hash}\n${tool_hash}\n")
set(record "${TEMPORARY}.signature")
if(EXISTS "${OUTPUT}" AND EXISTS "${record}")
    file(SHA256 "${OUTPUT}" output_hash)
    file(READ "${record}" previous)
    if(previous STREQUAL "${signature}${output_hash}\n")
        return()
    endif()
endif()
get_filename_component(output_dir "${OUTPUT}" DIRECTORY)
get_filename_component(temporary_dir "${TEMPORARY}" DIRECTORY)
file(MAKE_DIRECTORY "${output_dir}" "${temporary_dir}")
execute_process(COMMAND "${LRELEASE}" "${SOURCE}" -qm "${TEMPORARY}"
    RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "lrelease failed for ${SOURCE}: ${result}")
endif()
file(RENAME "${TEMPORARY}" "${OUTPUT}")
file(SHA256 "${OUTPUT}" output_hash)
file(WRITE "${record}.tmp" "${signature}${output_hash}\n")
file(RENAME "${record}.tmp" "${record}")
